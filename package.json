{
	"name": "deemix",
	"private": true,
	"description": "A hybrid monorepo that wraps deemix-webui and lets you use the deemix-js library",
	"repository": "https://github.com/bambanah/deemix.git",
	"author": "Bambanah",
	"license": "GPL-3.0-only",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"dev": "turbo run dev --filter=deemix-webui...",
		"dev:gui": "turbo run deemix-gui#dev",
		"build": "turbo run build",
		"lint": "turbo run lint",
		"type-check": "turbo run type-check",
		"test": "turbo run test",
		"package": "turbo run package",
		"make": "turbo run make",
		"compile:cli": "turbo run deemix-cli#compile",
		"ci": "turbo run lint type-check build test",
		"clean": "rimraf .turbo node_modules --glob **/dist **/out **/node_modules **/.turbo **/tsconfig.tsbuildinfo",
		"prepare": "husky"
	},
	"devDependencies": {
		"@changesets/cli": "^2.31.1",
		"@commitlint/cli": "^19.8.1",
		"@commitlint/config-conventional": "^19.8.1",
		"@eslint/js": "^9.39.5",
		"@total-typescript/tsconfig": "^1.0.4",
		"@types/eslint-config-prettier": "^6.11.3",
		"@types/node": "^24.19.2",
		"@typescript-eslint/parser": "~8.39.1",
		"esbuild": "^0.25.12",
		"eslint": "^9.39.5",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-vue": "^10.11.1",
		"globals": "^16.5.0",
		"husky": "^9.1.7",
		"npm-run-all2": "^8.0.4",
		"prettier": "^3.9.10",
		"prettier-plugin-tailwindcss": "^0.6.14",
		"rimraf": "^6.1.3",
		"tsup": "^8.5.1",
		"tsx": "^4.23.15",
		"turbo": "^2.11.9",
		"typescript": "~5.9.3",
		"typescript-eslint": "8.39.1",
		"vitest": "^4.1.12",
		"vue-eslint-parser": "^10.4.1"
	},
	"packageManager": "pnpm@11.23.0+sha512.f00082e5b283a199b74e079da28d155c008fe232f44c8a06ea7ddfa014ecf719fc362f790ecc67b28106ddac2afb24c49a9a079159da560b2ce7d1e98efd11af"
}
