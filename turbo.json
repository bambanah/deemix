{
	"$schema": "https://turborepo.org/schema.json",
	"tasks": {
		"lint": {
			"outputs": []
		},
		"dev": {
			"persistent": true,
			"cache": false,
			"passThroughEnv": ["LASTFM_API_KEY", "LASTFM_API_SECRET"]
		},
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**"]
		},
		"type-check": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"test": {
			"dependsOn": ["^build"]
		},
		"package": {
			"dependsOn": ["build", "^build"],
			"outputs": ["dist/**", "out/**"]
		},
		"make": {
			"dependsOn": ["build", "^build"],
			"outputs": ["dist/**", "out/**"]
		},
		"compile": {
			"dependsOn": ["build", "^build"],
			"outputs": ["dist/**", "out/**"]
		}
	}
}
